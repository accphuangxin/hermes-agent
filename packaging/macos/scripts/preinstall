#!/bin/bash
# packaging/macos/scripts/preinstall
# Runs before payload is extracted.  Exit non-zero to abort installation.
set -euo pipefail

# Require macOS 13 (Ventura) or newer
OS_MAJOR=$(sw_vers -productVersion | cut -d. -f1)
if (( OS_MAJOR < 13 )); then
    echo "error: hermes-agent requires macOS 13 (Ventura) or later." >&2
    echo "       Your system is running macOS $(sw_vers -productVersion)." >&2
    exit 1
fi

# Require Apple Silicon (this pkg is arm64-only).
# Use sysctl hw.optional.arm64 instead of uname -m — the latter returns
# x86_64 when the script is invoked under Rosetta translation, causing a
# false-positive failure on Apple Silicon machines.
IS_ARM64=$(sysctl -n hw.optional.arm64 2>/dev/null || echo "0")
if [[ "${IS_ARM64}" != "1" ]]; then
    echo "error: This installer is built for Apple Silicon (arm64)." >&2
    echo "       Please download the Intel (x86_64) installer instead." >&2
    exit 1
fi

# Remove stale venv before payload extraction so the new venv installs cleanly.
INSTALL_DIR="/usr/local/hermes"
if [[ -d "${INSTALL_DIR}/venv" ]]; then
    echo "==> Removing previous venv for clean install"
    rm -rf "${INSTALL_DIR}/venv"
fi

exit 0
