#!/bin/bash
# packaging/macos/scripts/postinstall
# Rewrites build-machine paths in the venv to the real install location,
# then verifies the installation.
set -euo pipefail

INSTALL_DIR="/usr/local/hermes"
VENV_DIR="${INSTALL_DIR}/venv"
BIN_DIR="/usr/local/bin"
PYTHON_BIN="${INSTALL_DIR}/bin/python3"   # embedded PBS Python (always at correct path)

# ── Ensure /usr/local/bin exists ──────────────────────────────────────────────
if [[ ! -d "${BIN_DIR}" ]]; then
    mkdir -p "${BIN_DIR}"
fi

# ── Rewrite build-machine paths using the embedded Python ─────────────────────
# The venv was created at build time inside the payload staging area, so all
# shebang lines and pyvenv.cfg point to a path like:
#   /Users/runner/work/.../build/macos-pkg/payload/usr/local/hermes/...
# We need to replace that prefix with /usr/local/hermes.
#
# Using the embedded Python (not the venv) avoids bash/sed pipe-exit-code
# issues under 'set -euo pipefail' and handles binary files safely.
echo "==> Relocating venv paths to ${INSTALL_DIR}"

"${PYTHON_BIN}" - "${INSTALL_DIR}" "${VENV_DIR}" <<'PYEOF'
import os, sys

install_dir = sys.argv[1]
venv_dir    = sys.argv[2]
pyvenv_cfg  = os.path.join(venv_dir, 'pyvenv.cfg')

# ── Read build prefix from pyvenv.cfg ──
build_prefix = None
try:
    with open(pyvenv_cfg) as f:
        for line in f:
            if line.startswith('home = '):
                python_home = line.split('=', 1)[1].strip()
                # home = /BUILD_ROOT/payload/usr/local/hermes/bin
                # strip trailing /bin to get the install root prefix
                build_prefix = python_home.rstrip('/')
                if build_prefix.endswith('/bin'):
                    build_prefix = build_prefix[:-4]
                break
except Exception as e:
    print(f'    Warning: could not read pyvenv.cfg: {e}')

if not build_prefix or build_prefix == install_dir:
    print('    Paths already correct — no rewrite needed.')
else:
    print(f'    from: {build_prefix}')
    print(f'    to:   {install_dir}')

    old_bytes = build_prefix.encode()
    new_bytes = install_dir.encode()

    def rewrite(path):
        try:
            with open(path, 'rb') as f:
                data = f.read()
            if old_bytes not in data:
                return
            with open(path, 'wb') as f:
                f.write(data.replace(old_bytes, new_bytes))
            print(f'    rewrote: {os.path.relpath(path, venv_dir)}')
        except Exception as e:
            print(f'    skip {os.path.basename(path)}: {e}')

    # 1. Scripts in venv/bin (shebang lines, skip symlinks)
    bin_path = os.path.join(venv_dir, 'bin')
    if os.path.isdir(bin_path):
        for name in sorted(os.listdir(bin_path)):
            fpath = os.path.join(bin_path, name)
            if os.path.isfile(fpath) and not os.path.islink(fpath):
                rewrite(fpath)

    # 2. pyvenv.cfg
    rewrite(pyvenv_cfg)

    # 3. .pth / RECORD / direct_url.json in site-packages
    lib_dir = os.path.join(venv_dir, 'lib')
    if os.path.isdir(lib_dir):
        for root, _dirs, files in os.walk(lib_dir):
            for name in files:
                if name.endswith(('.pth', '.json')) or name == 'RECORD':
                    rewrite(os.path.join(root, name))

# ── Fix symlinks in venv/bin that point to build-machine absolute paths ──
# venv/bin/python3 etc. are symlinks to the embedded Python binary.
# They must point to the real install location, not the build-machine path.
bin_path = os.path.join(venv_dir, 'bin')
python_bin = os.path.join(install_dir, 'bin', 'python3')
python_bin_versioned = os.path.join(install_dir, 'bin', 'python3.11')

fixed_symlinks = 0
if os.path.isdir(bin_path):
    for name in sorted(os.listdir(bin_path)):
        fpath = os.path.join(bin_path, name)
        if not os.path.islink(fpath):
            continue
        target = os.readlink(fpath)
        # Only fix symlinks pointing to build-machine absolute paths
        if not os.path.isabs(target):
            continue
        if build_prefix and not target.startswith(build_prefix) and not target.startswith('/Users/'):
            continue
        # Determine correct target: versioned python or plain python3
        if 'python3.1' in target:  # python3.11, python3.12, etc.
            new_target = python_bin_versioned
        elif 'python3' in target or 'python' in target:
            new_target = python_bin
        else:
            continue
        if not os.path.exists(new_target):
            continue
        os.unlink(fpath)
        os.symlink(new_target, fpath)
        print(f'    relinked: bin/{name} -> {new_target}')
        fixed_symlinks += 1

if fixed_symlinks:
    print(f'    Fixed {fixed_symlinks} symlink(s).')

print('    Done.')
PYEOF

# ── Verify the venv works ─────────────────────────────────────────────────────
echo "==> Verifying installation"
VERIFY_ERR=$("${VENV_DIR}/bin/python3" -c "import hermes_cli" 2>&1)
VERIFY_EXIT=$?
if [[ ${VERIFY_EXIT} -ne 0 ]]; then
    echo "error: venv verification failed — hermes_cli not importable" >&2
    echo "  python:   ${VENV_DIR}/bin/python3" >&2
    echo "  arch:     $(uname -m)" >&2
    echo "  error:    ${VERIFY_ERR}" >&2
    # 检查 python3 二进制架构是否与系统匹配
    if command -v file &>/dev/null; then
        echo "  binary:   $(file "${VENV_DIR}/bin/python3" 2>/dev/null)" >&2
    fi
    # Print pyvenv.cfg for diagnosis
    if [[ -f "${VENV_DIR}/pyvenv.cfg" ]]; then
        echo "  pyvenv.cfg:" >&2
        cat "${VENV_DIR}/pyvenv.cfg" >&2
    fi
    # 列出 site-packages 里是否有 hermes_cli
    SP=$("${VENV_DIR}/bin/python3" -c "import sysconfig; print(sysconfig.get_path('purelib'))" 2>/dev/null || true)
    if [[ -n "${SP}" ]]; then
        echo "  site-packages: ${SP}" >&2
        ls "${SP}/hermes_cli" 2>/dev/null | head -5 >&2 || echo "  hermes_cli dir not found in site-packages" >&2
    fi
    exit 1
fi
echo "    OK"

# ── Fix permissions ───────────────────────────────────────────────────────────
chmod -R a+rX "${INSTALL_DIR}"
chmod 755 "${BIN_DIR}/hermes" "${BIN_DIR}/hermes-agent" "${BIN_DIR}/hermes-acp" \
          "${BIN_DIR}/hermes-agent-manager" "${BIN_DIR}/ham" "${BIN_DIR}/hks" 2>/dev/null || true

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║         hermes-agent installation complete            ║"
echo "╠══════════════════════════════════════════════════════╣"
echo "║                                                        ║"
echo "║  Run: hermes                                           ║"
echo "║                                                        ║"
echo "║  If 'hermes' is not found, add /usr/local/bin to PATH:║"
echo "║    echo 'export PATH=\"/usr/local/bin:$PATH\"' >>       ║"
echo "║          ~/.zprofile && source ~/.zprofile             ║"
echo "║                                                        ║"
echo "║  To uninstall:                                         ║"
echo "║    sudo rm -rf /usr/local/hermes                       ║"
echo "║    sudo rm /usr/local/bin/hermes{,-agent,-acp}         ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

exit 0
